{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient.OtlpMetricExporter": "Warning",
        "System.Net.Http.HttpClient.OtlpTraceExporter": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "API": {
    "PlatformAPI": "http://localhost:5001",
    "PlatformAPIReadOnly": "http://localhost:50011"
  },
  "Custom": {
    "PlatformAPIKey": "8LKvrh6C2fe8mKXZ"
  }
}
