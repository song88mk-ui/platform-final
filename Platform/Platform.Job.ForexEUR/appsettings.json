{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http.HttpClient": "Error"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient.OtlpMetricExporter": "Warning",
        "System.Net.Http.HttpClient.OtlpTraceExporter": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "ConnectionStrings": {
    "Platform": "Server=127.0.0.1, 1433;Database=Platform;User Id=sa;Password=YourStrong@Passw0rd123;"
  },
  "OpenExchangeRates": {
