{
  "stryker-config": {
    "project": "Platform.Shared.csproj",
    "solution": "../Platform.sln",
    "mutate": [
      "Extensions/**/*.cs",
      "Utility/Formatting.cs",
      "Utility/Helper.cs",
      "Utility/JwtParser.cs",
      "Utility/LocalizedSearchMatcher.cs",
      "Helpers/**/*.cs",
      "!Extensions/BetAuditEntityExtension.cs",
      "!Extensions/BetSelectionAuditEntityExtension.cs"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 80
    }
  }
}
