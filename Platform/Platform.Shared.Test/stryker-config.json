{
  "stryker-config": {
    "project": "Platform.Shared.csproj",
    "solution": "../Platform.sln",
    "mutate": [
      "Extensions/**/*.cs",
      "Utility/Formatting.cs",
      "Utility/Helper.cs",
      "Utility/JwtParser.cs",
      "Utility/LocalizedSearchMatcher.cs",
      "Helpers/**/*.cs",
      "Providers/**/*.cs",
      "!Providers/MTS/*.cs",
      "!Extensions/BetAuditEntityExtension.cs",
      "!Extensions/BetSelectionAuditEntityExtension.cs"
    ],
    "ignore-methods": [
      "LogInformation",
      "LogError",
      "LogWarning",
      "LogDebug",
      "LogTrace",
      "LogCritical"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 92,
      "low": 82,
      "break": 80
    }
  }
}
