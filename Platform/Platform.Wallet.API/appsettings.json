{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient.OtlpMetricExporter": "Warning",
        "System.Net.Http.HttpClient.OtlpTraceExporter": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Wallet": "Server=localhost,1433;Database=Wallet;User Id=sa;Password=secret;"
  },
  "Custom": {
    "APIKey": "PXcEbJ3SqDyt8Ee5"
  }
}
